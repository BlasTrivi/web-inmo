---
/** Portada de proyecto (.phero). El <img> es el candidato a LCP: eager + fetchpriority alto. */
import type { NavItem, Project } from '../data/projects';
import { CTX, pictureHtml } from '../lib/images';
import { ribbonHtml } from '../lib/ribbon';
import { nb } from '../lib/typo';
import { ASESOR, asesorLink } from '../config/site';
import { hasAvailability } from '../lib/sections';

export interface Props {
  project: Project;
  /** Índice de la portada (por defecto, el del proyecto; la versión compacta de agotados pasa uno reducido) */
  nav?: NavItem[];
}
const { project, nav = project.nav } = Astro.props;
const img = await pictureHtml(project.hero.image, CTX.hero, {
  alt: project.hero.alt,
  attrs: project.hero.kenBurns ? { class: 'kb' } : {},
});
const showAsesor = hasAvailability(project); // todos menos los 100% vendidos
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="phero" id="top" data-title={project.name}>
  <Fragment set:html={img} />
  <div class="in">
    <div>
      <Fragment set:html={ribbonHtml(project, 'hero')} />
      <span class="k an">{project.kicker}</span>
      <h1 class="an">{nb(project.name)}</h1>
      <p class="loc an">{project.loc}</p>
      {showAsesor && <a class="asesor-btn an" data-asesor href={asesorLink(project.name)} target="_blank" rel="noopener">{ASESOR.label}<span aria-hidden="true">→</span></a>}
    </div>
    <nav aria-label={`Secciones de ${project.name}`}>
      <ul class="idx">
        {nav.map((n, i) => <li class="an"><a href={`#${n.id}`}><small>{pad(i + 1)}</small>{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <span class="cue" aria-hidden="true">↓</span>
</section>
