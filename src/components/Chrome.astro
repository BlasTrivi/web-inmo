---
/**
 * Elementos fijos del sitio: barra de progreso, scrim del header, logo, nav superior,
 * menú, preloader, telón de transición, barra de contexto, cursor, visor de showroom 3D
 * y visor de galería. Comportamiento en `src/scripts/main.js`.
 */
import CookieConsent from './CookieConsent.astro';
import { SITE, WA_MESSAGES, waLink } from '../config/site';
import { menuItems } from '../data/projects';
import { pictureHtml } from '../lib/images';
import { nb } from '../lib/typo';

// Logos de marca (SVG del manual): fondo oscuro -> blanco + rojo; fondo claro -> gris + rojo
const logoOnDark = '/brand/logo-white-red.svg';
const logoOnLight = '/brand/logo-gray-red.svg';
const preImg = `<img src="${logoOnDark}" width="179" height="75" alt="" decoding="async">`;
const menuImg = await pictureHtml(
  'trinity2_exterior_2.webp',
  { sizes: '55vw', widths: [768, 1080, 1440] },
  { alt: '' },
);
export interface Props {
  /** Nombre del proyecto de la página (para el mensaje del botón de WhatsApp); sin él, mensaje general */
  waProject?: string;
}
const { waProject } = Astro.props;
// TODO-CLIENTE: confirmar texto del mensaje (plantillas en site.ts → WA_MESSAGES)
const waHref = waLink(waProject ? WA_MESSAGES.project.replace('{proyecto}', waProject) : WA_MESSAGES.home);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div id="sp" aria-hidden="true"><i></i></div>
<div id="hdr" aria-hidden="true"></div>
<header class="site-header">
<a class="brand" href="/" aria-label="INMO Desarrollos, inicio">
  <img class="lg-dark" src={logoOnDark} width="179" height="75" alt="INMO Desarrollos" fetchpriority="high" decoding="async" />
  <img class="lg-light" src={logoOnLight} width="179" height="75" alt="" aria-hidden="true" decoding="async" />
</a>
<div class="topnav">
  <a class="t-label" href="/#proyectos">Elegí tu departamento</a>
  <button class="burger" id="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu"><i></i><i></i></button>
</div>
</header>

<nav class="menu" id="menu" aria-label="Principal">
  <div class="mimg"><Fragment set:html={menuImg} /><div class="cap t-label">Departamentos grandes, en serio · Asunción</div></div>
  <div class="mcol" data-lenis-prevent>
    <ul>
      {menuItems.map((item, i) => <li><a href={item.href}><small>{pad(i + 1)}</small>{nb(item.label)}</a></li>)}
    </ul>
    <div class="aside t-body">
      <div><span class="mid t-label">WhatsApp</span><br /><a href={SITE.whatsapp} target="_blank" rel="noopener">{SITE.phoneDisplay}</a></div>
      <div><span class="mid t-label">Correo</span><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
      <div><span class="mid t-label">Oficinas</span><br />Av. Santa Teresa 2106, Torre 2, Piso 17<br />Torres del Paseo, Asunción</div>
      <div class="row t-label">
        <a href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a><a href={SITE.social.facebook} target="_blank" rel="noopener">Facebook</a><a href={SITE.social.tiktok} target="_blank" rel="noopener">TikTok</a><a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>
</nav>

<div class="pre" id="pre" aria-hidden="true">
  <div class="lcard"><Fragment set:html={preImg} /><span>Departamentos<br />grandes, en serio</span></div>
  <div class="num" id="preNum">00</div>
  <div class="bar" id="preBar"></div>
</div>
<div class="trans" id="trans" aria-hidden="true">
  <div class="lcard"><Fragment set:html={preImg} /><span id="transTxt">Departamentos<br />grandes, en serio</span></div>
</div>
<div class="ctx" id="ctx" aria-live="polite"><span class="nm" id="ctxNm"></span><span class="st" id="ctxSt"></span><a class="lnk" id="ctxLnk" href={SITE.whatsapp} target="_blank" rel="noopener">Consultar</a></div>
<a class="wa" id="wa" href={waHref} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp" title="Escribinos por WhatsApp">
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
</a>
<div class="cur" id="cur" aria-hidden="true"><span class="lbl">Deslizá</span></div>
<div class="sr" id="sr" data-lenis-prevent inert>
  <div class="srbar">
    <span class="t-label" id="srT">Showroom virtual 3D</span>
    <div class="srk">
      <a class="lnk" id="srExt" href={SITE.whatsapp} target="_blank" rel="noopener">Abrir en pestaña nueva</a>
      <button class="x t-label" type="button" id="srX" aria-label="Cerrar el showroom">Cerrar ×</button>
    </div>
  </div>
  <div class="emb-consent" id="srC" hidden>
    <p class="emb-t">Para ver el showroom 3D necesitamos tu permiso para cargar contenido de Urbania3D, que puede usar cookies propias.</p>
    <button type="button" class="emb-btn" data-embeds-grant>Cargar showroom 3D</button>
    <a class="emb-lnk" id="srCExt" href="#" target="_blank" rel="noopener">Abrir en pestaña nueva ↗</a>
    <a class="emb-sm" href="/cookies/">Ver política de cookies</a>
  </div>
  <iframe id="srF" title="Showroom virtual 3D" loading="lazy" allow="fullscreen; xr-spatial-tracking; accelerometer; gyroscope; magnetometer" referrerpolicy="no-referrer-when-downgrade"></iframe>
  <p class="srhint t-label mid">Si el showroom no carga acá, abrilo en una pestaña nueva.</p>
</div>
<dialog class="pd" id="pd" aria-labelledby="pdT">
  <div class="pdbar">
    <div class="pdh">
      <span class="t-label mid" id="pdN">Plano</span>
      <h2 class="pdt" id="pdT">Plano</h2>
      <p class="t-label mid" id="pdS" hidden></p>
    </div>
    <div class="pdk">
      <button type="button" class="pdb" id="pdPrev" aria-label="Plano anterior"><span aria-hidden="true">←</span></button>
      <button type="button" class="pdb" id="pdNext" aria-label="Plano siguiente"><span aria-hidden="true">→</span></button>
      <button type="button" class="pdb" id="pdZoom" aria-label="Ampliar" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
      <button type="button" class="pdb" id="pdX" aria-label="Cerrar el plano"><span aria-hidden="true">×</span></button>
    </div>
  </div>
  <div class="pdstage" id="pdStage">
    <div class="pdpaper" id="pdPaper"><img id="pdImg" alt="" draggable="false" decoding="async" /></div>
  </div>
  <p class="pdhint t-label mid"><span class="d">Clic para ampliar · Arrastrá para mover · ← → cambian de plano · Esc cierra</span><span class="t">Tocá o pellizcá para ampliar · Arrastrá para mover</span></p>
</dialog>
<CookieConsent />
<div class="gv" id="gv" data-lenis-prevent inert>
  <div class="lab t-label">Galería</div>
  <button class="x" id="gvX" type="button" aria-label="Cerrar">×</button>
  <div class="col" id="gvCol"></div>
</div>
