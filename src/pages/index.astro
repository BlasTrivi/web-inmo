---
import ShowroomEmbed from '../components/ShowroomEmbed.astro';
import Base from '../layouts/Base.astro';
import { SITE, absoluteUrl } from '../config/site';
import { projects, buildings, buildingNames as names, listEs, buildingsIntro as introHtml, projectBySlug, orderIndex, LEGACY_STOCK } from '../data/projects';
import { ribbonHtml } from '../lib/ribbon';
import { renumber } from '../lib/typo';
import { getFragments, processHtml } from '../lib/html';
import {
  ORG_ID,
  breadcrumbSchema,
  graph,
  homeItemListSchema,
  organizationSchema,
  webPageSchema,
  websiteSchema,
} from '../lib/schema';

// --- Orden único de edificios (projects.ts → PROJECT_ORDER) ---
// 1) bloques verticales "<slug>-home": se reubican en los mismos huecos, ordenados por PROJECT_ORDER
const baseFragments = getFragments('home');
const slotIdx = baseFragments.map((f, i) => (/-home$/.test(f.id) ? i : -1)).filter((i) => i >= 0);
const sortedHome = slotIdx
  .map((i) => baseFragments[i])
  .sort((a, b) => orderIndex(a.id.replace(/-home$/, '')) - orderIndex(b.id.replace(/-home$/, '')));
const fragments = baseFragments.map((f, i) => {
  const k = slotIdx.indexOf(i);
  if (k === -1) return f;
  const slug = sortedHome[k].id.replace(/-home$/, '');
  const p = projects.find((x) => x.slug === slug);
  const html = p ? renumber(sortedHome[k].html, p.order).replace('<!--ribbon-->', ribbonHtml(p)) : sortedHome[k].html;
  return { ...sortedHome[k], html };
});

// 2) slider "Proyectos": las tarjetas salen de projects.ts (todos los edificios de PROJECT_ORDER).
//    Los que no tienen página propia (Trinity 1, Marquis) apuntan a su ficha en "Entregados", nunca a un 404.
const sliderHtml = buildings
  .map((b) => {
    const img = b.image ? `<img src="assets/${b.image}" alt="${b.alt}" loading="lazy">` : '';
    return `<a href="${b.href}"${b.image ? '' : ' class="noimg"'}>${img}${ribbonHtml(b)}<span class="cap"><b>${b.name}</b></span></a>`;
  })
  .join(' ');
const dotsHtml = buildings.map((_, i) => (i === 0 ? '<i class="on"></i>' : '<i></i>')).join('');
// cinta del manifiesto: todos los nombres, dos veces para el bucle (la copia va oculta; el listado accesible es estático)
const mqSpans = names.map((n) => `<span>${n}</span>`).join('');
const mqHtml = `<p class="vh">Edificios de INMO: ${listEs(names)}.</p><div class="mq" aria-hidden="true"><div class="in">${mqSpans}${mqSpans.replace(/<span>/g, '<span class="dup">')}</div></div>`;
// select del formulario: un <option> por edificio + asesoramiento (el valor sigue siendo el nombre, como lee el envío por WhatsApp)
const optsHtml = ['Ninguno en particular', ...names, 'Asesoramiento para invertir'].map((n) => `<option>${n}</option>`).join('');

// select "Tema de interés" (el texto elegido viaja tal cual en el mensaje de WhatsApp / mail)
const TEMAS = [
  'Quiero comprar para vivir',
  'Quiero invertir',
  'Unidades disponibles y precios',
  'Visitar un showroom o el edificio',
  'Postventa / soy propietario',
  'Otro',
];
const temasHtml = TEMAS.map((n) => `<option>${n}</option>`).join('');

// 3) "Entregados": los <li> siguen el mismo orden y se renumeran
function reorderDelivered(html: string): string {
  const re = /<li class="ex" data-key="([^"]+)"[\s\S]*?<\/li>/g;
  const items: { key: string; html: string }[] = [];
  let first = -1;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(html))) {
    if (first < 0) first = m.index;
    last = m.index + m[0].length;
    items.push({ key: m[1], html: m[0] });
  }
  if (!items.length) return html;
  items.sort((a, b) => orderIndex(a.key) - orderIndex(b.key));
  // fajita de stock sobre la foto de la ficha (los que no tienen foto, como Marquis, no la llevan)
  const withRibbon = (key: string, h: string): string => {
    const src = projects.find((x) => x.slug === key) ?? LEGACY_STOCK[key];
    return src ? h.replace('<div class="pic">', `<div class="pic">${ribbonHtml(src)}`) : h;
  };
  const body = items
    .map((it, i) =>
      withRibbon(it.key, it.html).replace(/<span class="mid">\d\d<\/span>/, `<span class="mid">${String(i + 1).padStart(2, '0')}</span>`),
    )
    .join('\n      ');
  return html.slice(0, first) + body + html.slice(last);
}
const processed = await Promise.all(
  fragments.map((f) => {
    let h = f.html;
    if (f.id === 'proyectos') h = h.replace('{{PSLIDER}}', sliderHtml).replace('{{PSDOTS}}', dotsHtml).replace('{{PINTRO}}', introHtml);
    if (f.id === 'manifiesto') h = h.replace('{{MQ}}', mqHtml);
    if (f.id === 'contacto') h = h.replace('{{POPTS}}', optsHtml).replace('{{TOPTS}}', temasHtml).replace('{{MAIL}}', SITE.contactEmail);
    if (f.id === 'entregados') h = reorderDelivered(h);
    return processHtml(h);
  }),
);
const preloads = processed.flatMap((p) => p.preloads);

const jsonLd = graph([
  organizationSchema(),
  websiteSchema(),
  webPageSchema({
    path: '/',
    name: SITE.defaultTitle,
    description: SITE.description,
    image: absoluteUrl('/og/default.png'),
    about: ORG_ID,
  }),
  breadcrumbSchema([{ name: 'Inicio', path: '/' }], '/'),
  homeItemListSchema(),
]);
const slugs = projects.map((p) => p.slug);
---

<Base
  title={SITE.defaultTitle}
  description={SITE.description}
  path="/"
  ogImage="/og/default.png"
  ogImageAlt="INMO Desarrollos · Departamentos grandes, en serio"
  markdown="/index.md"
  jsonLd={jsonLd}
  preloads={preloads}
  isHome
>
  <script slot="head" is:inline define:vars={{ slugs }}>
    // Compatibilidad con los enlaces antiguos de la versión de una sola página (#/slug, #/slug/seccion, #/seccion)
    (function () {
      var h = location.hash;
      if (h.indexOf('#/') !== 0) return;
      var p = h.slice(2).split('/');
      if (!p[0]) { location.replace('/'); return; }
      if (slugs.indexOf(p[0]) > -1) location.replace('/' + p[0] + '/' + (p[1] ? '#' + p[1] : ''));
      else location.replace('/#' + p[0]);
    })();
  </script>
  {processed.map((p, i) => (
    <>
      <Fragment set:html={p.html} />
      {fragments[i].id === 'trinity-2-home' && <ShowroomEmbed project={projectBySlug('trinity-2')} id="showroom-trinity-2" theme="light" level={3} />}
      {fragments[i].id === 'president-tower-home' && <ShowroomEmbed project={projectBySlug('president-tower')} id="showroom-president-tower" theme="light" level={3} />}
    </>
  ))}
</Base>
