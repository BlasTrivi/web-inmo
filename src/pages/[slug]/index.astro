---
import Base from '../../layouts/Base.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import ShowroomEmbed from '../../components/ShowroomEmbed.astro';
import MoreProjects from '../../components/MoreProjects.astro';
import Disponibles from '../../components/Disponibles.astro';
import { SITE, absoluteUrl } from '../../config/site';
import { projects, projectPath, type Project } from '../../data/projects';
import { getFragments, processHtml } from '../../lib/html';
import { COMPACT_SECTIONS, compactFicha, compactGaleria, compactNav, compactProyecto, compactTipologias } from '../../lib/compact';
import { renumber } from '../../lib/typo';
import { buildNav, hasAvailability } from '../../lib/sections';
import { CTX, preloadInfo } from '../../lib/images';
import {
  breadcrumbSchema,
  graph,
  organizationSchema,
  projectId,
  projectSchema,
  webPageSchema,
  websiteSchema,
} from '../../lib/schema';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const path = projectPath(project.slug);
// Proyecto 100% vendido: versión compacta (portada, "El proyecto", galería chica, ficha, aviso y otros proyectos)
const soldOut = project.stock === 'agotado';
let fragments = getFragments(`projects/${project.slug}`);
if (soldOut) fragments = fragments.filter((f) => (COMPACT_SECTIONS as readonly string[]).includes(f.id));
const shape = (f: { id: string; html: string }): string => {
  if (!soldOut) return f.id === 'proyecto' ? renumber(f.html, project.order) : f.html;
  if (f.id === 'proyecto') return compactProyecto(renumber(f.html, project.order));
  if (f.id === 'galeria') return compactGaleria(f.html);
  if (f.id === 'tipologias') return compactTipologias(f.html);
  return compactFicha(f.html);
};
// Índice estandarizado: solo las secciones que la página realmente tiene, en el orden único (lib/sections.ts)
const showShowroom = !soldOut && !!project.showroom;
const showDisponibles = hasAvailability(project);
const nav = buildNav([...fragments.map((f) => f.id), ...(showShowroom ? ['showroom'] : []), ...(showDisponibles ? ['disponibles'] : [])]);
const processed = await Promise.all(fragments.map((f) => processHtml(shape(f))));
const preloads = [await preloadInfo(project.hero.image, CTX.hero), ...processed.flatMap((p) => p.preloads)];
const ogImage = `/og/${project.slug}.png`;
const title = `${project.title} · ${SITE.titleSuffix}`;

const jsonLd = graph([
  organizationSchema(),
  websiteSchema(),
  webPageSchema({
    path,
    name: title,
    description: project.description,
    image: absoluteUrl(ogImage),
    about: projectId(project),
  }),
  breadcrumbSchema(
    [
      { name: 'Inicio', path: '/' },
      { name: 'Proyectos', path: '/#proyectos' },
      { name: project.name, path },
    ],
    path,
  ),
  ...projectSchema(project, absoluteUrl(ogImage)),
]);
---

<Base
  title={title}
  description={project.description}
  path={path}
  ogImage={ogImage}
  ogImageAlt={`${project.name} · ${project.ogTagline}`}
  markdown={`/${project.slug}.md`}
  jsonLd={jsonLd}
  preloads={preloads.slice(0, 1)}
>
  <ProjectHero project={project} nav={soldOut ? compactNav(nav) : nav} />
  {processed.map((p, i) => (
    <>
      <Fragment set:html={p.html} />
      {!soldOut && project.showroom && fragments[i].id === 'tipologias' && <ShowroomEmbed project={project} id="showroom" theme="light" level={2} />}
    </>
  ))}
  {showDisponibles && <Disponibles project={project} />}
  {soldOut && (
    <section class="page dark soldout" id="vendido" data-title="100% vendido">
      <div class="pad so-in">
        <div class="so-n" data-r aria-hidden="true">100%</div>
        <div class="so-t">
          <h2 class="t-h" data-r>{project.name} está 100% vendido</h2>
          <p class="t-body" data-r>Todas las unidades de {project.name} ya tienen dueño. Si estás buscando un departamento, mirá los proyectos que hoy tienen unidades disponibles.</p>
          <div class="acts" data-r><a class="lnk big" href="/#proyectos">Ver proyectos disponibles →</a></div>
        </div>
      </div>
      <div class="tail"></div>
    </section>
  )}
  <MoreProjects project={project} />
</Base>
